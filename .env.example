ACP_ENVIRONMENT=development
ACP_DATABASE_URL=sqlite:///./data/control-plane.db

# Administrator REST API credential. Generate a unique 32+ character secret.
ACP_ADMIN_API_KEY=replace-with-at-least-32-random-characters

# Server-side agent registry: comma-separated agent-id:secret entries.
ACP_AGENT_API_KEYS=antigravity:replace-with-a-32-character-key,codex:replace-with-another-32-character-key

# Local stdio only: pass these from the MCP client's `env` configuration.
# ACP_AGENT_ID=antigravity
# ACP_AGENT_API_KEY=replace-with-the-same-antigravity-key-as-above

ACP_LEASE_TTL_SECONDS=900
ACP_MAX_LEASE_TTL_SECONDS=3600
ACP_LOG_LEVEL=INFO
ACP_DOCS_ENABLED=true

# Use `stdio` for a locally spawned MCP server or `streamable-http` for HTTP.
ACP_MCP_TRANSPORT=stdio
ACP_MCP_HOST=127.0.0.1
ACP_MCP_PORT=8001
# Set this to the external HTTPS origin behind a reverse proxy in production.
# ACP_MCP_PUBLIC_URL=https://mcp.example.com
